# BlockAuth configuration. Copy this file to ".env.local" in the repository root and fill in the blanks.
# ".env.local" is git-ignored: never commit it, and never put real values in this example file.
# The backend reads ".env.local" at startup; real environment variables override it.

# --- Neon PostgreSQL (the application's branch) ---
# JDBC URL of the direct (non-pooled) host. Form: jdbc:postgresql://<neon-host>/<database>?sslmode=require
DB_URL=
# Neon role name and its password. The password is a secret.
DB_USERNAME=
DB_PASSWORD=

# --- Neon PostgreSQL (test branch) ---
# Used only by the backend integration tests, which empty the tables before each test.
# Point these at a separate branch, never at the branch DB_URL points at.
TEST_DB_URL=
TEST_DB_USERNAME=
TEST_DB_PASSWORD=

# --- Blockchain ---
# JSON-RPC endpoint of the chain. The local Hardhat node listens here.
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
# Expected chain ID. The backend refuses to start if the node reports a different one.
BLOCKCHAIN_CHAIN_ID=31337
# Address printed by "npx hardhat run scripts/deploy.js --network localhost". Form: 0x + 40 hex characters.
CONTRACT_ADDRESS=
# Private key of the account that deployed the contract (Hardhat account #0 locally). The backend signs
# register/revoke/activate transactions with it. Form: 0x + 64 hex characters. This is a secret.
# Hardhat's built-in keys are public knowledge: use them only on the local node.
BLOCKCHAIN_OPERATOR_PRIVATE_KEY=

# --- Application ---
# Comma-separated wallet addresses that receive the ADMIN role when they register. Without at least one
# entry nobody can open the admin pages. These are public addresses, not keys.
BLOCKAUTH_ADMIN_WALLETS=
# Exact origin of the web app. POST requests from any other origin are rejected, and the host part is
# written into every sign-in message.
APP_ORIGIN=http://localhost:5173
# Lifetime of a sign-in message in seconds (60-600).
CHALLENGE_TTL_SECONDS=120
# How long a session may stay idle before the user must sign in again.
SESSION_TIMEOUT=30m
# Whether cookies carry the Secure flag. "false" only for http://localhost; must be "true" when deployed.
SESSION_COOKIE_SECURE=false
# Spring profile: dev, test or prod. Takes effect as a real environment variable (Docker Compose passes
# it through); a value that exists only in this file does not select a profile.
SPRING_PROFILES_ACTIVE=dev
# Addresses of the reverse proxies allowed to report the client address in X-Forwarded-For, as a
# comma-separated list of CIDR ranges. Used only when forwarded headers are on: in the prod profile, and in
# Docker Compose, which sets this to nginx's fixed address itself. Default: this machine only
# (127.0.0.1/32, ::1/128). Name your proxy here when it runs elsewhere.
# TRUSTED_PROXIES=127.0.0.1/32, ::1/128

# --- Account security ---
# Encrypts the authenticator secrets of the second step and keys the stored backup-code hashes. 32 random bytes, Base64-encoded (44 characters).
# Secret. Generate one, for example in PowerShell:
#   $b = New-Object byte[] 32; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
# or with OpenSSL: openssl rand -base64 32
SECOND_STEP_ENCRYPTION_KEY=
# Days a device stays trusted after the second step passed on it (1-365).
TRUSTED_DEVICE_DAYS=30
# Waiting period before a wallet reactivation, a second-step reset or the lifting of the emergency stop
# takes effect, as a duration such as 10m or 1h (1 second to 7 days). Any administrator can cancel during it.
ADMIN_ACTION_DELAY=10m
# Most of these settings have sensible defaults and can be left out. Every optional feature below is OFF by
# default; the standard local setup (Hardhat node + Neon + npm run dev) needs none of them.

# Highest number of days an administrator may give a read-only API key (1-365). The form follows it.
# API_KEY_MAX_DAYS=90
# Database connections per backend instance. Raise it when the load test shows threads waiting.
# DB_POOL_SIZE=5
# Threads for the background jobs (delayed actions, chain checks, cleanup, model training).
# SCHEDULER_POOL_SIZE=4
# Delete sign-in assessments and audit events older than this many days. 0 keeps everything (default).
# RETENTION_DAYS=0

# --- Trust score (rules). A sign-in starts at 100 and loses each penalty that applies. ---
# At or above ALLOW_AT the signature is enough. From SECOND_STEP_AT up to ALLOW_AT - 1 (50-89 by default) the
# second step is asked for when the wallet has one, and the signature alone is enough when it has none.
# Below SECOND_STEP_AT a wallet without a second step is refused.
# TRUST_ALLOW_AT=90
# TRUST_SECOND_STEP_AT=50
# TRUST_NEW_DEVICE_PENALTY=30
# TRUST_NEW_NETWORK_PENALTY=20
# TRUST_FLAGGED_WALLET_PENALTY=35
# TRUST_REPEATED_FAILURES_PENALTY=25
# Failed or blocked attempts from the same address within an hour that count as "repeated".
# TRUST_REPEATED_FAILURES_THRESHOLD=3
# TRUST_LINKED_TO_FLAGGED_PENALTY=35
# How many shared-device hops away a flagged wallet still counts (1-5).
# TRUST_GRAPH_DEPTH=3
# true: an address in the same IPv4 /24 or IPv6 /48 as an earlier session is a known network. false: exact IP.
# TRUST_NETWORK_PREFIX_MATCH=false

# --- Anomaly model (unsupervised Isolation Forest beside the rules; see docs/RISK_MODEL.md) ---
# off | shadow (default: stored and shown, never changes a decision) | enforce (may lower a score, never raise it)
# ANOMALY_MODE=shadow
# Anomaly score (0.5 ordinary, 1 clear outlier) at which the penalty starts, and the largest penalty.
# ANOMALY_THRESHOLD=0.6
# ANOMALY_MAX_PENALTY=30
# Recorded ordinary sign-ins needed before training on real data instead of the synthetic cold-start data.
# ANOMALY_MIN_REAL_SAMPLES=200
# Most recent sign-ins of one wallet used for training (limits how much one wallet can shape the model).
# ANOMALY_PER_WALLET_CAP=50
# When the model is retrained (cron, server time zone). "-" switches scheduled training off.
# ANOMALY_TRAINING_SCHEDULE=0 30 3 * * *

# --- Blockchain transactions (defaults suit the local node; see docs/SEPOLIA.md for Sepolia) ---
# BLOCKCHAIN_RECEIPT_TIMEOUT=30s
# BLOCKCHAIN_CONFIRMATIONS=1
# How long a request waits for another chain write before answering 503 BLOCKCHAIN_BUSY.
# BLOCKCHAIN_LOCK_WAIT=10s
# BLOCKCHAIN_GAS_LIMIT_CAP=200000
# Highest fee per gas the backend will pay, in gwei; above it the write is refused.
# BLOCKCHAIN_MAX_FEE_GWEI=200
# Below this operator balance (ETH) a warning is logged and shown on the admin dashboard.
# BLOCKCHAIN_LOW_BALANCE_ETH=0.05
# How often the chain is read for changes BlockAuth did not make (cron). Every minute on a free public RPC tier.
# CHAIN_SYNC_SCHEDULE=*/15 * * * * *

# --- Redis (optional; for several backend instances). Enable with SPRING_PROFILES_ACTIVE=dev,redis ---
# Redis must be private, password-protected, and reached over TLS anywhere beyond this machine.
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6380
# REDIS_PASSWORD=
# REDIS_SSL=false

# --- E-mail alerts for sign-ins on a new device (optional) ---
# MAIL_ENABLED=false
# MAIL_HOST=
# MAIL_PORT=587
# MAIL_USERNAME=
# The SMTP password is a secret.
# MAIL_PASSWORD=
# MAIL_FROM=
# STARTTLS is required. Set false only for a local mail catcher (Mailpit: MAIL_HOST=127.0.0.1, MAIL_PORT=1025,
# MAIL_SMTP_AUTH=false).
# MAIL_STARTTLS_REQUIRED=true
# MAIL_SMTP_AUTH=true
# MAIL_MAX_ALERTS_PER_HOUR=3

# --- Frontend build (optional) ---
# Block explorer prefix for transaction links, e.g. https://sepolia.etherscan.io/tx/ (unset for the local chain).
# VITE_EXPLORER_TX_URL=
